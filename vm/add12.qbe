# vm/add12.qbe — Slice 2 smoke test: compute (+ 1 2) → 3.
#
# ABI: every ZINC temp is a `l` (long) = Value* pointer into a per-frame
# Value[] activation record.  `l %out` is the result slot (40-byte Value).
#
# - alloc8 40  → a stack Value slot (Value is a 40-byte struct, zinctypes.h)
# - val_number_into(%slot, n)  → *slot = val_number(n)   [qbe_shims.c]
# - prim_add(%out, %a1, %a2)   → dispatch "+" through exec_primitive with
#                                the ZINC RTL arg convention   [qbe_shims.c]
#
# Compiled by QBE to BOTH architectures:
#   qbe -t amd64_sysv -o add12.s        add12.qbe
#   qbe -t arm64     -o .aarch64/add12.s add12.qbe
# assembled with the cosmo assemblers, then linked into a fat APE by cosmocc.
# The exported IL symbol `$add12` becomes the C symbol `add12` ($ stripped).

export
function $add12(l %out) {
@start
	%a1 =l alloc8 40
	%a2 =l alloc8 40
	call $val_number_into(l %a1, l 1)
	call $val_number_into(l %a2, l 2)
	call $prim_add(l %out, l %a1, l %a2)
	ret
}

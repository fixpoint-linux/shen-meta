// gc_safety.dl — Soufflé Datalog ruleset for GC-safety verification
//
// Architecture:
//   vm/*.c --clang -Xclang -ast-dump=json--> extract.py --CSV--> gc_safety.dl
//
// Phased rollout:
//   Phase 0: schema + may_collect + skeleton rules
//   Phase 1: full AST extraction, all 10 CSVs, may_collect transitive closure
//   Phase 2: GC-liveness + must_rooted + root_miss (THIS FILE)
//   Phase 3: memcpy_unbarriered (THIS FILE)
//   Phase 5: calibration fixes (defining_alloc, CaseStmt BB scoping, fresh_target)
//   Phase 6: interprocedural root_miss + single_store_unbarriered + push_pop_balance
//   Phase 7: real basic-block CFG (cfg_edge-based analysis), param_rooted suppression,
//            canonical must_rooted via reaches_unrooted complement

// ── Input fact schemas ────────────────────────────────────────────────

.decl function(name:symbol)
.input function(IO=file, delimiter=",", headers=true, filename="facts/function.csv")

.decl cfg_edge(f:symbol, from_stmt_id:number, to_stmt_id:number, kind:symbol)
.input cfg_edge(IO=file, delimiter=",", headers=true, filename="facts/cfg_edge.csv")

.decl stmt_allocs(f:symbol, stmt_id:number, callee:symbol)
.input stmt_allocs(IO=file, delimiter=",", headers=true, filename="facts/stmt_allocs.csv")

.decl stmt_pushes(f:symbol, stmt_id:number, root_kind:symbol, slot_expr:symbol)
.input stmt_pushes(IO=file, delimiter=",", headers=true, filename="facts/stmt_pushes.csv")

.decl stmt_pops(f:symbol, stmt_id:number, pop_count:number, pkind:symbol)
.input stmt_pops(IO=file, delimiter=",", headers=true, filename="facts/stmt_pops.csv")

.decl stmt_memcpy(f:symbol, stmt_id:number, dst_expr:symbol, src_expr:symbol, nbytes:symbol)
.input stmt_memcpy(IO=file, delimiter=",", headers=true, filename="facts/stmt_memcpy.csv")

.decl stmt_barrier(f:symbol, stmt_id:number, target_expr:symbol)
.input stmt_barrier(IO=file, delimiter=",", headers=true, filename="facts/stmt_barrier.csv")

.decl var_decl(f:symbol, name:symbol, type:symbol, is_gc_managed:number)
.input var_decl(IO=file, delimiter=",", headers=true, filename="facts/var_decl.csv")

.decl field_assign(f:symbol, stmt_id:number, base:symbol, field_path:symbol, rhs_kind:symbol)
.input field_assign(IO=file, delimiter=",", headers=true, filename="facts/field_assign.csv")

.decl call_graph(caller:symbol, callee:symbol)
.input call_graph(IO=file, delimiter=",", headers=true, filename="facts/call_graph.csv")

// ── Phase 2 new input relations ───────────────────────────────────────

.decl next_stmt(f:symbol, from:number, to:number)
// Phase 7: next_stmt now ONLY serves push_pop_balance (depth tracking).
// All other analyses (pushed_may, live_at, reach_stmt) use cfg_edge.
// Depth over a cyclic CFG is out of scope — push_pop_balance remains on
// the simple intra-BB next_stmt chain for sound depth counting.
.input next_stmt(IO=file, delimiter=",", headers=true, filename="facts/next_stmt.csv")

.decl gc_use(f:symbol, stmt_id:number, v:symbol)
.input gc_use(IO=file, delimiter=",", headers=true, filename="facts/gc_use.csv")

.decl gc_def(f:symbol, stmt_id:number, v:symbol)
.input gc_def(IO=file, delimiter=",", headers=true, filename="facts/gc_def.csv")

// ── Phase 5 new input relations ───────────────────────────────────────

.decl defining_alloc(f:symbol, var:symbol, stmt_id:number)
.input defining_alloc(IO=file, delimiter=",", headers=true, filename="facts/defining_alloc.csv")

// ── Phase 6 new input relations ───────────────────────────────────────

.decl call_site(f:symbol, stmt_id:number, callee:symbol)
.input call_site(IO=file, delimiter=",", headers=true, filename="facts/call_site.csv")

.decl array_store(f:symbol, stmt_id:number, base_var:symbol)
.input array_store(IO=file, delimiter=",", headers=true, filename="facts/array_store.csv")

// ── Phase 7 new input relations ───────────────────────────────────────

.decl param_rooted(f:symbol, var:symbol)
// GC-managed pointer params whose slot is rooted by the caller.
// Suppresses root_miss for these vars (Fix 3c: caller-rooted parameters).
.input param_rooted(IO=file, delimiter=",", headers=true, filename="facts/param_rooted.csv")


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 1 — may_collect transitive closure
// ═══════════════════════════════════════════════════════════════════════

.decl may_collect(f:symbol)

may_collect("gc_alloc").
may_collect("gc_alloc_oldgen").
may_collect("gc_alloc_atomic").
may_collect("collect").
may_collect("collect_nursery").
may_collect("gcalloc_internal").

// Transitive closure: if a function calls something in may_collect,
// it is also in may_collect.
may_collect(caller) :- call_graph(caller, callee), may_collect(callee).


// ── Phase 6 (Rule 3): transitive_alloc_site ───────────────────────────
//
// A call site is an "allocating site" if its callee is in may_collect.
// stmt_allocs only captures direct calls to the 6 seed allocators; this
// relation extends that to indirect callers (a call to B that
// transitively calls gc_alloc is invisible to stmt_allocs alone).
// Uses call_site (all resolved callees) + may_collect TC closure.
// Superset of stmt_allocs, so existing root_miss rows survive.

.decl transitive_alloc_site(f:symbol, stmt_id:number)
transitive_alloc_site(f, s) :- call_site(f, s, callee), may_collect(callee).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 2 — helpers (depend only on inputs)
// ═══════════════════════════════════════════════════════════════════════
//
// pop_to_at and first_stmt are in a lower stratum than pushed_may
// because pushed_may negates them.

.decl pop_to_at(f:symbol, stmt_id:number)
pop_to_at(f, s) :- stmt_pops(f, s, _, "pop_to").

// push_at / pop_one_at: shared by first_stmt and push_pop_balance.
.decl push_at(f:symbol, stmt_id:number)
push_at(f, s) :- stmt_pushes(f, s, _, _).

.decl pop_one_at(f:symbol, stmt_id:number)
pop_one_at(f, s) :- stmt_pops(f, s, _, "pop_one").

// any_stmt: union of all statement-id-bearing nodes.
.decl any_stmt(f:symbol, stmt_id:number)
any_stmt(f, s) :- push_at(f, s).
any_stmt(f, s) :- pop_one_at(f, s).
any_stmt(f, s) :- pop_to_at(f, s).
any_stmt(f, s) :- stmt_allocs(f, s, _).
any_stmt(f, s) :- stmt_memcpy(f, s, _, _, _).
any_stmt(f, s) :- stmt_barrier(f, s, _).

// first_stmt (Phase 7): any node with no incoming cfg_edge.
// Ground on all_stmt (all cfg-edge endpoints), not just any_stmt
// (which only covers push/pop/alloc/memcpy/barrier statements) — the
// function's first statement is often a plain assignment.
.decl all_stmt(f:symbol, stmt_id:number)
all_stmt(f, s) :- any_stmt(f, s).
all_stmt(f, s) :- cfg_edge(f, s, _, _).
all_stmt(f, s) :- cfg_edge(f, _, s, _).

.decl first_stmt(f:symbol, stmt_id:number)
first_stmt(f, s) :- all_stmt(f, s), !cfg_edge(f, _, s, _).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 3a — pushed_may forward fixpoint (over cfg_edge)
// ═══════════════════════════════════════════════════════════════════════
//
// pushed_may(f, v, s): variable v MAY be on the shadow stack at
// statement s (on at least one path).  Propagates forward through
// cfg_edge edges unless killed by pop_to.
//
// Phase 7: uses cfg_edge instead of next_stmt for all-path propagation.

.decl pushed_may(f:symbol, v:symbol, stmt_id:number)

// Base: a push at statement s makes v pushed at s.
pushed_may(f, v, s) :- stmt_pushes(f, s, _, v).

// Propagation: if v is pushed at s, and s_next follows s via cfg_edge,
// and s is not a pop_to, then v is still pushed at s_next.
pushed_may(f, v, s_next) :-
    pushed_may(f, v, s),
    cfg_edge(f, s, s_next, _),
    !pop_to_at(f, s).

// Note: pop_one (gc_root_pop()) is NOT modelled as a kill in Phase 2.
// This is conservative (over-approximates rootedness), meaning we may
// miss some root-miss patterns that involve pop_one.  pop_to is the
// dominant pattern in the historical bug fixes (longjmp unwind).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 3b — live_at backward fixpoint (over cfg_edge)
// ═══════════════════════════════════════════════════════════════════════
//
// live_at(f, v, s): GC-managed variable v is live at statement s
// (its current value may be read at or after s).  Standard backward
// dataflow: a use generates liveness, a definition kills it.
//
// Phase 7: uses cfg_edge instead of next_stmt.

.decl live_at(f:symbol, v:symbol, stmt_id:number)

// Base: a read (gc_use) at statement s makes v live at s.
live_at(f, v, s) :- gc_use(f, s, v).

// Propagation: if v is live at s_next, and s precedes s_next via cfg_edge,
// and s does NOT define v, then v is live at s.
live_at(f, v, s) :-
    cfg_edge(f, s, s_next, _),
    live_at(f, v, s_next),
    !gc_def(f, s, v).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 3c — reaches_unrooted forward may-analysis (Phase 7)
// ═══════════════════════════════════════════════════════════════════════
//
// reaches_unrooted(f, v, s): on AT LEAST ONE path from the function
// entry, v is GC-managed and NOT on the shadow stack at s.  This is the
// complement of must_rooted: must_rooted requires v to be pushed on EVERY
// path (or the var was never pushed at all, making reaches_unrooted true
// everywhere).
//
// This is the canonical must_rooted semantics deferred from Phase 2
// ("intra-BB first, extend later").  Phase 7 delivers that extension.
//
// Positive only (no negation) → can share stratum with pushed_may/live_at.

.decl reaches_unrooted(f:symbol, v:symbol, stmt_id:number)

// Base 1: a GC-managed var is unrooted at the function entry.
reaches_unrooted(f, v, s) :- var_decl(f, v, _, 1), first_stmt(f, s).

// Propagation: if v is unrooted at s, and s_next follows s, and s_next
// does NOT push v, then v is still unrooted at s_next.
reaches_unrooted(f, v, s_next) :-
    reaches_unrooted(f, v, s),
    cfg_edge(f, s, s_next, _),
    !stmt_pushes(f, s, _, v).

// Base 2: after a pop_to, a GC-managed var may be unrooted again at the
// next statement (pop_to clears the shadow stack, re-exposing all vars).
reaches_unrooted(f, v, s_next) :-
    var_decl(f, v, _, 1),
    cfg_edge(f, s, s_next, _),
    pop_to_at(f, s).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 4 — must_rooted (negates reaches_unrooted)
// ═══════════════════════════════════════════════════════════════════════
//
// must_rooted(f, v, s): variable v IS rooted at statement s on ALL paths.
// True iff v is GC-managed and NOT reaches_unrooted at s.  This correctly
// handles branches: if v is pushed on only one branch of an if, then at
// the join point reaches_unrooted is true (via the other branch) and
// must_rooted is false.
//
// Negates reaches_unrooted (Stratum 3) → must be Stratum 4.

.decl must_rooted(f:symbol, v:symbol, stmt_id:number)
must_rooted(f, v, s) :-
    var_decl(f, v, _, 1),
    all_stmt(f, s),
    !reaches_unrooted(f, v, s).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 5 — root_miss violation
// ═══════════════════════════════════════════════════════════════════════
//
// root_miss(f, s, v): GC-managed var v is live across an allocating
// call at statement s, but v is NOT must_rooted at s.  The GC may move
// the object v points to, leaving v stale.
//
// Phase 7: adds !param_rooted(f, v) — caller-rooted params are suppressed
// (the caller roots the slot whose address was passed; Fix 3c).
//
// Negates must_rooted (stratum 4) → must be stratum 5.

.decl root_miss(f:symbol, stmt_id:number, var_name:symbol)

root_miss(f, s, v) :-
    transitive_alloc_site(f, s),
    var_decl(f, v, _, 1),       // is_gc_managed = 1
    live_at(f, v, s),
    !must_rooted(f, v, s),
    !defining_alloc(f, v, s),
    !param_rooted(f, v).

// Note: may_collect(_) guard omitted from body because
// transitive_alloc_site already contains only sites whose callee is in
// may_collect (direct seed allocators or transitive indirect callers).
// It is a superset of the previous stmt_allocs-based set, so existing
// root_miss rows survive.


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 6a — reach_stmt (positive transitive closure over cfg_edge)
// ═══════════════════════════════════════════════════════════════════════
//
// Phase 7: uses cfg_edge instead of next_stmt.

.decl reach_stmt(f:symbol, from:number, to:number)
reach_stmt(f, a, b) :- cfg_edge(f, a, b, _).
reach_stmt(f, a, c) :- reach_stmt(f, a, b), cfg_edge(f, b, c, _).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 6b — barrier_covers_alloc (depends on reach_stmt)
// ═══════════════════════════════════════════════════════════════════════
//
// A memcpy dst is covered by a barrier iff the barrier comes after the
// memcpy and before the next may-collect allocation.

.decl barrier_covers_alloc(f:symbol, s_memcpy:number, dst:symbol, s_alloc:number)
barrier_covers_alloc(f, s_memcpy, dst, s_alloc) :-
    stmt_memcpy(f, s_memcpy, dst, _, _),
    stmt_barrier(f, s_barrier, dst),
    stmt_allocs(f, s_alloc, _),
    reach_stmt(f, s_memcpy, s_barrier),
    reach_stmt(f, s_barrier, s_alloc).


// ═══════════════════════════════════════════════════════════════════════
// STRATUM 6c — memcpy_unbarriered (negates barrier_covers_alloc)
// ═══════════════════════════════════════════════════════════════════════
//
// A memcpy is unbarriered when a may-collect allocation follows it and
// no barrier covers that dst-allocation pair.

.decl memcpy_unbarriered(f:symbol, stmt_id:number, dst_expr:symbol)
memcpy_unbarriered(f, s_memcpy, dst) :-
    stmt_memcpy(f, s_memcpy, dst, _, _),
    stmt_allocs(f, s_alloc, _),
    reach_stmt(f, s_memcpy, s_alloc),
    !barrier_covers_alloc(f, s_memcpy, dst, s_alloc).


// ═══════════════════════════════════════════════════════════════════════
// Phase 6 (Rule 4) — single_store_unbarriered
// ═══════════════════════════════════════════════════════════════════════
//
// Single-Value stores into GC-managed arrays (ne[i]=v, a->data[i]=v,
// (*env)[i]=v) need a write barrier, mirroring memcpy_unbarriered.

// STRATUM 6b — barrier_covers_store (depends on reach_stmt)
.decl barrier_covers_store(f:symbol, s_store:number, base:symbol, s_alloc:number)
barrier_covers_store(f, s_store, base, s_alloc) :-
    array_store(f, s_store, base),
    stmt_barrier(f, s_barrier, base),
    stmt_allocs(f, s_alloc, _),
    reach_stmt(f, s_store, s_barrier),
    reach_stmt(f, s_barrier, s_alloc).

// STRATUM 6c — single_store_unbarriered (negates barrier_covers_store)
.decl single_store_unbarriered(f:symbol, stmt_id:number, base_var:symbol)
single_store_unbarriered(f, s_store, base) :-
    array_store(f, s_store, base),
    stmt_allocs(f, s_alloc, _),
    reach_stmt(f, s_store, s_alloc),
    !barrier_covers_store(f, s_store, base, s_alloc).


// ═══════════════════════════════════════════════════════════════════════
// Phase 6 (Rule 1) — push_pop_balance (ON next_stmt, not cfg_edge)
// ═══════════════════════════════════════════════════════════════════════
//
// Depth tracking over a cyclic CFG is out of scope — push_pop_balance
// remains on the simple intra-BB next_stmt chain, which is sufficient
// for detecting unbalanced push/pop in straight-line code and across
// case-statement boundaries.
//
// Phase 7: push_pop_balance is UNCHANGED.  next_stmt continues to serve
// this analysis exclusively.  push_at, pop_one_at, any_stmt, and
// first_stmt are declared in Stratum 2 (shared).

.decl has_successor(f:symbol, stmt_id:number)
has_successor(f, s) :- next_stmt(f, s, _).

.decl func_exit(f:symbol, stmt_id:number)
func_exit(f, s) :- any_stmt(f, s), !has_successor(f, s).

.decl depth(f:symbol, stmt_id:number, d:number)
depth(f, s, 0) :- first_stmt(f, s).
depth(f, s2, d) :-
    next_stmt(f, s1, s2), depth(f, s1, d),
    !push_at(f, s1), !pop_one_at(f, s1), !pop_to_at(f, s1).
depth(f, s2, d + 1) :-
    next_stmt(f, s1, s2), depth(f, s1, d), push_at(f, s1),
    !pop_to_at(f, s1), d < 128.
depth(f, s2, d - 1) :-
    next_stmt(f, s1, s2), depth(f, s1, d), pop_one_at(f, s1),
    !pop_to_at(f, s1), d >= 1.
depth(f, s2, 0) :-
    next_stmt(f, s1, s2), pop_to_at(f, s1).

.decl push_pop_balance(f:symbol, stmt_id:number, kind:symbol, current_depth:number)
push_pop_balance(f, s, "pop_without_push", 0) :-
    pop_one_at(f, s), depth(f, s, 0).
push_pop_balance(f, s, "push_never_popped", d) :-
    func_exit(f, s), depth(f, s, d), d > 0.


// ── Output relations ───────────────────────────────────────────────────

.output may_collect(IO=file, delimiter=",", headers=true, filename="out/may_collect.csv")
.output root_miss(IO=file, delimiter=",", headers=true, filename="out/root_miss.csv")
.output memcpy_unbarriered(IO=file, delimiter=",", headers=true, filename="out/memcpy_unbarriered.csv")
.output single_store_unbarriered(IO=file, delimiter=",", headers=true, filename="out/single_store_unbarriered.csv")
.output push_pop_balance(IO=file, delimiter=",", headers=true, filename="out/push_pop_balance.csv")
